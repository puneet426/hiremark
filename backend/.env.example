# Copy to .env and fill in. Never commit .env.
ENV=development                 # set to "production" on the server
SECRET_KEY=                     # required in production: python -c "import secrets;print(secrets.token_hex(32))"
APP_ORIGIN=http://localhost:3000   # the public https address of the site in production
DATABASE_URL=                   # blank = local SQLite file; production: postgresql+psycopg://user:pass@host/db
ADMIN_EMAILS=                   # comma-separated; these emails become admins when they sign up

# AI interviewer (free tiers). Leave both blank to run the scripted interviewer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_DAILY_CALL_BUDGET=4000

# Code runner. Required in production: a self-hosted Judge0 (1.13.1 or newer) on its own VM.
JUDGE0_URL=
JUDGE0_TOKEN=

# Payments. Blank keys = simulated checkout in development, payments off in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (confirmation links, recruiter requests)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Hiremark <no-reply@yourdomain>

MAX_CONCURRENT_INTERVIEWS=20
ATS_UNLOCK_SCORE=60
